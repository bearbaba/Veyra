{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run typecheck && bun scripts/build-mainnet-pilot.ts",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "https://veyra-mainnet-v1-bff.onrender.com/api/health"
    },
    {
      "source": "/api/health/readiness",
      "destination": "https://veyra-mainnet-v1-bff.onrender.com/api/health/readiness"
    },
    {
      "source": "/api/auth/wallet-login/challenge",
      "destination": "https://veyra-mainnet-v1-bff.onrender.com/api/auth/wallet-login/challenge"
    },
    {
      "source": "/api/auth/wallet-login/complete",
      "destination": "https://veyra-mainnet-v1-bff.onrender.com/api/auth/wallet-login/complete"
    },
    {
      "source": "/api/auth/session/restore",
      "destination": "https://veyra-mainnet-v1-bff.onrender.com/api/auth/session/restore"
    },
    {
      "source": "/api/auth/session/logout",
      "destination": "https://veyra-mainnet-v1-bff.onrender.com/api/auth/session/logout"
    },
    {
      "source": "/api/auth/x/capability",
      "destination": "https://veyra-mainnet-v1-bff.onrender.com/api/auth/x/capability"
    },
    {
      "source": "/api/auth/x/start",
      "destination": "https://veyra-mainnet-v1-bff.onrender.com/api/auth/x/start"
    },
    {
      "source": "/api/auth/x/finish",
      "destination": "https://veyra-mainnet-v1-bff.onrender.com/api/auth/x/finish"
    },
    {
      "source": "/api/identity/register/challenge",
      "destination": "https://veyra-mainnet-v1-bff.onrender.com/api/identity/register/challenge"
    },
    {
      "source": "/api/identity/register/complete",
      "destination": "https://veyra-mainnet-v1-bff.onrender.com/api/identity/register/complete"
    },
    {
      "source": "/api/identity/resolve",
      "destination": "https://veyra-mainnet-v1-bff.onrender.com/api/identity/resolve"
    },
    {
      "source": "/api/identity/prepare-payment",
      "destination": "https://veyra-mainnet-v1-bff.onrender.com/api/identity/prepare-payment"
    },
    {
      "source": "/api/identity/verify-payment",
      "destination": "https://veyra-mainnet-v1-bff.onrender.com/api/identity/verify-payment"
    },
    {
      "source": "/api/profile/me",
      "destination": "https://veyra-mainnet-v1-bff.onrender.com/api/profile/me"
    },
    {
      "source": "/api/social/friends",
