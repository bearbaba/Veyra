# Dedicated production-shaped TESTNET backend. Vercel serves the Vite
# frontend separately; this image runs the real Express BFF in a container
# platform with managed Postgres (no hidden localhost proxy).
#
# The image deliberately contains no .env files, secrets or browser bundle.
# Migrations are run separately by an authorized release job, not at boot.
FROM oven/bun:1.3.14 AS dependencies
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

FROM oven/bun:1.3.14
WORKDIR /app
ENV NODE_ENV=production \
    VEYRA_ENV=testnet \
    VEYRA_HOSTED_BACKEND=1 \
    BFF_PORT=3001
COPY --from=dependencies /app/node_modules ./node_modules
COPY --chown=bun:bun package.json .bun-version ./
COPY --chown=bun:bun src ./src
COPY --chown=bun:bun server ./server
USER bun
EXPOSE 3001
CMD ["bun", "server/bff.ts"]
