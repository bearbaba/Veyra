{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "VITE_VEYRA_ENV=mainnet VITE_VEYRA_UI_ONLY=0 VITE_VEYRA_TESTNET_PAY=0 VITE_VEYRA_MAINNET_MVP=0 VITE_VEYRA_MAINNET_PAY=1 VITE_VEYRA_IDENTITY_BETA=0 VITE_VEYRA_UNIFIED_STAGING=0 bun run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/api/:path*",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "rewrites": [
    { "source": "/api/health", "destination": "https://veyra-testnet-acceptance-bff.onrender.com/api/health" },
    { "source": "/api/health/readiness", "destination": "https://veyra-testnet-acceptance-bff.onrender.com/api/health/readiness" },
    { "source": "/api/auth/wallet-login/challenge", "destination": "https://veyra-testnet-acceptance-bff.onrender.com/api/auth/wallet-login/challenge" },
    { "source": "/api/auth/wallet-login/complete", "destination": "https://veyra-testnet-acceptance-bff.onrender.com/api/auth/wallet-login/complete" },
    { "source": "/api/auth/session/restore", "destination": "https://veyra-testnet-acceptance-bff.onrender.com/api/auth/session/restore" },
    { "source": "/api/auth/session/logout", "destination": "https://veyra-testnet-acceptance-bff.onrender.com/api/auth/session/logout" },
    { "source": "/api/auth/x/capability", "destination": "https://veyra-testnet-acceptance-bff.onrender.com/api/auth/x/capability" },
    { "source": "/api/auth/x/start", "destination": "https://veyra-testnet-acceptance-bff.onrender.com/api/auth/x/start" },
    { "source": "/api/auth/x/finish", "destination": "https://veyra-testnet-acceptance-bff.onrender.com/api/auth/x/finish" },
    { "source": "/api/identity/register/challenge", "destination": "https://veyra-testnet-acceptance-bff.onrender.com/api/identity/register/challenge" },
    { "source": "/api/identity/register/complete", "destination": "https://veyra-testnet-acceptance-bff.onrender.com/api/identity/register/complete" },
    { "source": "/api/identity/resolve", "destination": "https://veyra-testnet-acceptance-bff.onrender.com/api/identity/resolve" },
    { "source": "/api/identity/prepare-payment", "destination": "https://veyra-testnet-acceptance-bff.onrender.com/api/identity/prepare-payment" },
    { "source": "/api/identity/verify-payment", "destination": "https://veyra-testnet-acceptance-bff.onrender.com/api/identity/verify-payment" },
    { "source": "/api/profile/me", "destination": "https://veyra-testnet-acceptance-bff.onrender.com/api/profile/me" },
    { "source": "/api/social/friends", "destination": "https://veyra-testnet-acceptance-bff.onrender.com/api/social/friends" },
    { "source": "/api/gateway/balances", "destination": "https://veyra-testnet-acceptance-bff.onrender.com/api/gateway/balances" },
    { "source": "/api/gateway/estimate", "destination": "https://veyra-testnet-acceptance-bff.onrender.com/api/gateway/estimate" },
    { "source": "/api/gateway/transfer-status", "destination": "https://veyra-testnet-acceptance-bff.onrender.com/api/gateway/transfer-status" }
  ]
}
